{
    // ==================================================
    // 外観（テーマ・ウィンドウ）
    // ==================================================
    "workbench.colorTheme": "Dark+",
    "workbench.iconTheme": "material-icon-theme",
    "window.zoomLevel": 0,
    "window.title": "${rootName}${separator}${profileName}${separator}${appName}",

    // ==================================================
    // エディター基本
    // ==================================================
    "editor.fontFamily": "Cica",
    "editor.fontSize": 14,
    "editor.insertSpaces": true,
    "editor.tabCompletion": "on",
    "editor.renderWhitespace": "boundary",
    "editor.rulers": [
        80,
        100
    ],
    "editor.minimap.enabled": false,
    "editor.unicodeHighlight.allowedCharacters": {
        "〔": true,
        "〕": true
    },

    // ==================================================
    // 括弧・インデントの色分け・タブ
    // ==================================================
    "editor.bracketPairColorization.enabled": true,
    "workbench.colorCustomizations": {
        "editorBracketHighlight.foreground1": "#FF0000", // 赤
        "editorBracketHighlight.foreground2": "#FFBF3F", // 橙
        "editorBracketHighlight.foreground3": "#FFFF00", // 黄
        "editorBracketHighlight.foreground4": "#3FFF3F", // 緑
        "editorBracketHighlight.foreground5": "#3F7FFF", // 青
        "editorBracketHighlight.foreground6": "#FF7FFF", // 紫

        // タブとタブの間の区切り線（少し明るめに）
        "tab.border": "#6a6a6a",
        // アクティブタブの上端ライン（フォーカス時／非フォーカス時）
        "tab.activeBorderTop": "#3794ff",
        "tab.unfocusedActiveBorderTop": "#3794ff80",
        // アクティブタブはエディタと同じ色、非アクティブはぐっと暗くする
        "tab.activeBackground": "#1e1e1e",
        "tab.inactiveBackground": "#161616",
        // 非アクティブタブの文字を暗めにして差をつける
        "tab.inactiveForeground": "#8a8a8a",
        // マウスを乗せたタブを少し明るく
        "tab.hoverBackground": "#2a2d2e",
        // タブ列とエディタ本体の境目
        "editorGroupHeader.tabsBorder": "#555555"
    },
    "indentRainbow.colors": [
        "rgba(128,64,64,0.5)",
        "rgba(128,96,32,0.5)",
        "rgba(128,128,32,0.5)",
        "rgba(32,128,32,0.5)",
        // "rgba(64,128,128,0.5)",
        "rgba(32,64,128,0.5)",
        "rgba(128,64,128,0.5)"
    ],

    // ==================================================
    // ファイル・エクスプローラー
    // ==================================================
    "files.trimTrailingWhitespace": true,
    "explorer.compactFolders": false,

    // ==================================================
    // ターミナル
    // ==================================================
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.environmentChangesIndicator": "off",
    "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
    "terminal.integrated.initialHint": false,
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash"
        },
        // ディストリビューション名は環境によって違うので、-d で指定せず既定のディストリビューションを開く
        "Ubuntu (WSL)": {
            "path": "C:\\WINDOWS\\System32\\wsl.exe"
        }
    },
    // "terminal.integrated.shell.windows": "C:\\Windows\\sysnative\\bash.exe",

    // ==================================================
    // リモート（WSL など）
    // ==================================================
    "remote.autoForwardPortsSource": "hybrid",

    // ==================================================
    // Git・ソース管理
    // ==================================================
    "git.branchProtection": [
        "main",
        "develop"
    ],
    "git.openRepositoryInParentFolders": "never",
    "diffEditor.ignoreTrimWhitespace": false,

    // GitLens
    "gitlens.codeLens.enabled": false,
    "gitlens.currentLine.enabled": false,
    "gitlens.hovers.currentLine.enabled": false,
    "gitlens.menus": false,

    // Gitmoji
    "gitmoji.outputType": "code",
    "gitmoji.showEmojiCode": true,

    // Git Graph
    "git-graph.customEmojiShortcodeMappings": [
        {
            "shortcode": ":thumbsup:",
            "emoji": "👍"
        }
    ],

    // ==================================================
    // Vim
    // ==================================================
    "vim.leader": "<space>",
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.easymotion": true,
    "vim.sneak": true,
    "vim.incsearch": true,
    "vim.hlsearch": true,
    "vim.showcmd": true,
    "vim.showmodename": true,
    "vim.handleKeys": {
        "<C-f>": false,
        "<C-a>": false,
        "<C-p>": false,
        "<C-y>": false
    },
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "j"
            ],
            "after": [
                "<Esc>"
            ]
        },
        {
            "before": [
                "ｊ",
                "ｊ"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<leader>",
                "w"
            ],
            "commands": [
                ":w"
            ]
        },
        {
            "before": [
                "u"
            ],
            "commands": [
                "undo"
            ]
        },
        {
            "before": [
                "<C-r>"
            ],
            "commands": [
                "redo"
            ]
        }
    ],

    // ==================================================
    // 言語別設定
    // ==================================================
    // Markdown
    "[markdown]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "off",
            "other": "off"
        },
        "editor.colorDecorators": false
    },

    // JavaScript / TypeScript
    "js/ts.tsserver.checkNpmIsInstalled": false,

    // JSON
    "json.schemas": [
        {
            "fileMatch": ["**/dotfiles/config/Code/settings.json"],
            "url": "vscode://schemas/settings/user"
        }
    ],

    // Python
    "python.analysis.typeCheckingMode": "standard",
    "python.terminal.activateEnvironment": false,
    "python.terminal.shellIntegration.enabled": false,

    // ==================================================
    // その他の拡張機能
    // ==================================================
    // Code Spell Checker
    "cSpell.autoFormatConfigFile": true,
    // 言語に関係なく、技術用語やツール名の辞書を常に使う
    "cSpell.dictionaries": [
        "bash",
        "docker",
        "fonts",
        "fullstack",
        "git",
        "node",
        "npm",
        "powershell",
        "python",
        "shellscript"
    ],
    "cSpell.userWords": [
        "Cica",
        "easymotion",
        "hlsearch",
        "incsearch",
        "showcmd",
        "showmodename"
    ],

    // Claude Code
    "claudeCode.preferredLocation": "sidebar",
    "claudeCode.hideOnboarding": true,

    // Live Preview
    "livePreview.portNumber": 3030
}
